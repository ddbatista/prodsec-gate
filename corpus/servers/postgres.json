  "capture_method": "sandboxed-stdio",
  "capture_args": [
    "postgresql://localhost/dummy"
  ],
  "notes": "deprecated on npm",
  "tools": [
    {
      "name": "query",
      "description": "Run a read-only SQL query",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sql": {
            "type": "string"
          }
        }
      }
    }
  ],
  "labels": {
    "query": {
      "capabilities": [
        "untrusted_input",
        "private_data",
        "state_change"
      ],
      "reversible": false,
      "why": "runs caller SQL after BEGIN TRANSACTION READ ONLY in the same simple query, so 'COMMIT; ...' escapes the read-only transaction (verified in dist/index.js)"
    }
  },
  "expected_verdict": "GATE",
  "rationale": "Its one query tool is read-only in name only: a COMMIT in the SQL escapes the read-only transaction, so private rows sit beside irreversible writes."
}
